# Base image for Physical AI simulation builds.
# Adds build tools (colcon, rosdep, vcstool) to a ROS2 Humble desktop image.
# Simulation Containerfiles (e.g. ros2-humble-turtlebot3) use FROM this image.
#
# The ROS_BASE_IMAGE arg selects the upstream desktop image:
#   sloretz (default) — multi-arch (amd64 + arm64), works on Apple Silicon
#   osrf              — amd64 only
# Digest pinned for reproducibility — bump deliberately after testing.
ARG ROS_BASE_IMAGE=ghcr.io/sloretz/ros:humble-desktop@sha256:970146e40f7aaa818c5783e28ed5302489bc72f61efe92438a1613fcf90b7d5c
FROM ${ROS_BASE_IMAGE}

LABEL org.opencontainers.image.title="ROS2 Humble Base" \
      org.opencontainers.image.description="ROS2 Humble desktop with build tools — base layer for simulation images" \
      org.opencontainers.image.vendor="Red Hat" \
      org.opencontainers.image.source="https://github.com/redhat-appeng/physical-ai"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    build-essential \
    cmake \
    git \
    && rosdep init || true \
    && rosdep update \
    && rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /ros2_ws

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
