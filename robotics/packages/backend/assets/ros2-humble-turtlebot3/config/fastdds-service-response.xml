<?xml version="1.0" encoding="UTF-8"?>
<!--
  Humble/Fast DDS service responses use the RMW's named `service` publisher.
  Keep the default topic/request writer behavior unchanged; only allow the
  response writer two seconds to discover a late response reader.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <publisher profile_name="service">
    <qos>
      <reliability>
        <kind>RELIABLE</kind>
        <max_blocking_time>
          <sec>2</sec>
          <nanosec>0</nanosec>
        </max_blocking_time>
      </reliability>
    </qos>
  </publisher>
</profiles>
