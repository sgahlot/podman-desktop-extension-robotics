<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    Deliberately static: this proves safe insertion of an image-local model into
    the existing world. It is not a supported robot profile and has no ROS
    controllers, bridges, sensors, or navigation capability.
  -->
  <model name="boxbot">
    <pose>3 -1 0.15 0 0 0</pose>
    <static>true</static>
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1041667</ixx>
          <iyy>0.1708333</iyy>
          <izz>0.2166667</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.6 0.4 0.3</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.6 0.4 0.3</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.9 1</ambient>
          <diffuse>0.1 0.5 0.9 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
