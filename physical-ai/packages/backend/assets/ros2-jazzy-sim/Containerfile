# Jazzy simulation image: TurtleBot3 + Gazebo Harmonic + Nav2 + noVNC.
# Builds on top of the locally-built ros2-jazzy-base image.
#
# LOCAL_BASE_IMAGE must point to a locally-built ros2-jazzy-base tag.
# The extension passes this automatically during the two-phase build.
ARG LOCAL_BASE_IMAGE
FROM ${LOCAL_BASE_IMAGE}

LABEL org.opencontainers.image.title="ROS2 Jazzy TurtleBot3 Simulation" \
      org.opencontainers.image.description="ROS2 Jazzy with TurtleBot3, Gazebo Harmonic, Nav2, and noVNC for simulation" \
      org.opencontainers.image.vendor="Red Hat" \
      org.opencontainers.image.source="https://github.com/redhat-appeng/physical-ai"

# Gazebo Harmonic package repository (Ubuntu Noble)
RUN apt-get update && apt-get install -y --no-install-recommends \
    lsb-release wget gnupg \
    && wget -q https://packages.osrfoundation.org/gazebo.gpg \
         -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] https://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
         > /etc/apt/sources.list.d/gazebo-stable.list \
    && rm -rf /var/lib/apt/lists/*

# ROS2 Jazzy simulation + Nav2 packages (Tier 1 binaries on Ubuntu Noble)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    ros-jazzy-nav2-minimal-tb3-sim \
    ros-jazzy-teleop-twist-keyboard \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-gz-sim-vendor \
    && rm -rf /var/lib/apt/lists/*

# noVNC display stack: Xvfb + x11vnc + websockify + openbox
# Mesa software GL + EGL: libgl1-mesa-dri provides the llvmpipe/swrast driver, and
# libegl-mesa0 + libgbm1 provide off-screen EGL (surfaceless) so the Gazebo sensors
# plugin can render camera/lidar headless without a GPU (no GLX window → no segfault).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libegl1 \
    libgl1-mesa-dri \
    libegl-mesa0 \
    libgbm1 \
    mesa-utils \
    xvfb \
    x11vnc \
    novnc \
    python3-websockify \
    openbox \
    xterm \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# VirtualGL: GPU-render the Gazebo GUI viewport on the NVIDIA headless EGL device via
# `vglrun -d egl` — no /dev/dri render node required (the gz server already GPU-renders
# sensors through that same EGL device in-cluster). This moves the GUI off the llvmpipe
# CPU rasterizer (~1.5-3.5 cores), ending the CFS CPU throttling that made in-cluster
# navigation jumpy/stalling. See APPENG-6083. vglrun lives in /opt/VirtualGL/bin (added
# to PATH below); apt resolves its runtime deps from the .deb.
# The .deb is arch-specific — resolve it from the image's native arch (`dpkg
# --print-architecture` → amd64/arm64, matching VirtualGL's release asset names) so the
# arm64 and amd64 builds each pull the matching package (VirtualGL ships both).
ARG VIRTUALGL_VERSION=3.1.5
RUN apt-get update \
    && VGL_ARCH="$(dpkg --print-architecture)" \
    && wget -q "https://github.com/VirtualGL/virtualgl/releases/download/${VIRTUALGL_VERSION}/virtualgl_${VIRTUALGL_VERSION}_${VGL_ARCH}.deb" \
         -O /tmp/virtualgl.deb \
    && apt-get install -y --no-install-recommends /tmp/virtualgl.deb \
    && rm -f /tmp/virtualgl.deb \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/VirtualGL/bin:${PATH}"

RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# noVNC landing: full UI + autoconnect + auto-reconnect (background tabs often drop WebSockets)
RUN printf '<!DOCTYPE html>\n<html><head><meta http-equiv="refresh" content="0;url=vnc.html?autoconnect=true&reconnect=true&reconnect_delay=2000&resize=scale"></head></html>\n' \
    > /usr/share/novnc/index.html

WORKDIR /opt/ros2-demo

COPY entrypoint-gazebo.sh /entrypoint-gazebo.sh
COPY entrypoint-spawn-robot.sh /entrypoint-spawn-robot.sh
COPY entrypoint-nav2.sh /entrypoint-nav2.sh
COPY lib/validate-input.sh /usr/local/lib/physical-ai/validate-input.sh
COPY lib/load-validate-input.sh /usr/local/lib/physical-ai/load-validate-input.sh
COPY lib/patch-nav2-params.py /usr/local/lib/physical-ai/patch-nav2-params.py
COPY worlds/ /opt/ros2-demo/worlds/
COPY www/ /opt/ros2-demo/www/

RUN chmod +x /entrypoint-gazebo.sh /entrypoint-spawn-robot.sh /entrypoint-nav2.sh \
    && chmod 644 /usr/local/lib/physical-ai/validate-input.sh \
                 /usr/local/lib/physical-ai/load-validate-input.sh \
                 /usr/local/lib/physical-ai/patch-nav2-params.py

ENV TURTLEBOT3_MODEL=waffle

EXPOSE 6080 8080

ENTRYPOINT ["/bin/bash"]
CMD ["bash"]
