[0.164, "o", "\u001b[11D\u001b[32mg\u001b[32mc\u001b[32mm\u001b[32ms\u001b[32mg\u001b[39m \u001b[33m'\u001b[33mA\u001b[33mP\u001b[33mP\u001b[33mE\u001b[24m\u001b[33mN\u001b[33mG\u001b[33m-\u001b[33m5\u001b[33m7\u001b[33m6\u001b[33m5\u001b[33m:\u001b[33m \u001b[33mE\u001b[33mn\u001b[33mable Mac GPU passthrough, re-enable Gazebo Sensors, and align docs/tooling.\u001b[1B\u001b[39m\r\u001b[K\r\r\n\u001b[33mOn arm64, launchSimulation now passes /dev/dri and sets PHYSICAL_AI_USE_GPU\u001b[39m\u001b[K\r\r\n\u001b[33m(default via simulationGpuPassthrough). entrypoint-gazebo switches between\u001b[39m\u001b[K\r\r\n\u001b[33mvirtio-gpu and llvmpipe fallback, Sensors plugin is re-enabled in the Jazzy\u001b[39m\u001b[K\r\r\n\u001b[33mworld, and docs are updated to reflect current behavior (scan/imu available,\u001b[39m\u001b[K\r\r\n\u001b[33mNav2 still deferred). Also remove extension-\u001b[4m\u001b[33mlo\u001b[24mcal .internal and move the\u001b[39m\u001b[K\r\r\n\u001b[33msensor/GPU re-verification script to repo-level scripts/.'\u001b[39m\u001b[K\r\r\nbck-i-search: lo_\u001b[K\u001b[A\u001b[A\u001b[27C"]
[0.045, "o", "\u001b[6A\u001b[41D\u001b[32mp\u001b[32mo\u001b[39m\u001b[39m \u001b[39m\u001b[4ml\u001b[39m\u001b[4mo\u001b[4mg\u001b[24m\u001b[39ms\u001b[39m \u001b[39m-\u001b[39mf\u001b[39m \u001b[39mf\u001b[39me\u001b[39mf\u001b[39m8\u001b[39mb\u001b[39m9\u001b[39m6\u001b[39mb\u001b[39m9\u001b[39ma\u001b[39ma\u001b[39mf\u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[39m \u001b[1B\r\u001b[18@bck-i-search: log_\u001b[102C  \r\u001b[K\u001b[1B\u001b[K\u001b[1B\u001b[K\u001b[1B\u001b[K\u001b[1B\u001b[K\u001b[1B\u001b[K\u001b[1B\u001b[K\u001b[8A\u001b[6C"]
